// USOF Backend — Database Schema
// Paste this into https://dbdiagram.io (or File > Import > DBML) to render the ERD.
// Mirrors server/database/setup.sql.

enum user_role {
  user
  admin
  superadmin
}

enum post_status {
  active
  inactive
  resolved
}

enum comment_status {
  active
  inactive
  resolved
}

enum like_type {
  like
  dislike
}

enum notification_type {
  post_updated
  post_commented
  post_status_changed
}

Table users {
  id int [pk, increment]
  login varchar [unique, not null]
  password varchar [not null, note: 'bcrypt hash']
  full_name varchar [not null]
  email varchar [unique, not null]
  profile_picture_path varchar
  rating int [not null, default: 0]
  role user_role [not null, default: 'user']
  is_email_confirmed boolean [not null, default: false]
  email_verification_token varchar
  password_reset_token varchar
  password_reset_token_expires datetime
}

Table posts {
  id int [pk, increment]
  user_id int [not null]
  title varchar [unique, not null]
  publish_date timestamp [not null, default: `now()`]
  status post_status [not null, default: 'active']
  content text [not null]
}

Table post_attachments {
  post_id int [not null]
  attachment_path varchar [not null]

  indexes {
    (post_id, attachment_path) [pk]
  }
}

Table categories {
  id int [pk, increment]
  title varchar [unique, not null]
  description text
}

Table post_categories {
  post_id int [not null]
  category varchar [not null]

  indexes {
    (post_id, category) [pk]
  }
}

Table comments {
  id int [pk, increment]
  user_id int
  publish_date timestamp [not null, default: `now()`]
  content text
  post_id int [not null]
  parent_comment_id int
  status comment_status [not null, default: 'active']
}

Table likes {
  id int [pk, increment]
  user_id int [not null]
  comment_id int
  post_id int
  publish_date timestamp [not null, default: `now()`]
  type like_type [not null, default: 'like']

  indexes {
    (user_id, post_id) [unique]
    (user_id, comment_id) [unique]
  }

  Note: 'exactly one of post_id/comment_id is non-null (CHECK constraint)'
}

Table user_bans {
  id int [pk, increment]
  user_id int [not null]
  banned_by int
  reason varchar
  banned_at timestamp [not null, default: `now()`]
  expires_at datetime
  unbanned_at datetime
}

Table favorite_posts {
  id int [pk, increment]
  user_id int [not null]
  post_id int [not null]
  favorited_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, post_id) [unique]
  }
}

Table post_subscriptions {
  id int [pk, increment]
  user_id int [not null]
  post_id int [not null]
  subscribed_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, post_id) [unique]
  }
}

Table notifications {
  id int [pk, increment]
  user_id int [not null]
  post_id int [not null]
  type notification_type [not null]
  message varchar [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

Ref: posts.user_id > users.id [delete: cascade]
Ref: post_attachments.post_id > posts.id [delete: cascade]
Ref: post_categories.post_id > posts.id [delete: cascade]
Ref: post_categories.category > categories.title [delete: cascade, update: cascade]
Ref: comments.user_id > users.id [delete: set null]
Ref: comments.post_id > posts.id [delete: cascade]
Ref: comments.parent_comment_id > comments.id [delete: cascade]
Ref: likes.comment_id > comments.id [delete: cascade]
Ref: likes.post_id > posts.id [delete: cascade]
Ref: likes.user_id > users.id [delete: cascade]
Ref: user_bans.user_id > users.id [delete: cascade]
Ref: user_bans.banned_by > users.id [delete: set null]
Ref: favorite_posts.user_id > users.id [delete: cascade]
Ref: favorite_posts.post_id > posts.id [delete: cascade]
Ref: post_subscriptions.user_id > users.id [delete: cascade]
Ref: post_subscriptions.post_id > posts.id [delete: cascade]
Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.post_id > posts.id [delete: cascade]
