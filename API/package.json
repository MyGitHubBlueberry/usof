{
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev": "node --watch --env-file=.env server/index.js",
    "db:init": "node --env-file=.env ./server/database/init-user-and-db.js",
    "db:setup": "node --env-file=.env ./server/database/setup.js",
    "db:seed": "node --env-file=.env ./server/database/seed.js",
    "db:nuke": "node --env-file=.env ./server/database/nuke.js",
    "db:recreate": "npm run db:nuke && npm run db:init && npm run db:setup && npm run db:seed"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/sql": "^2.2.6",
    "adminjs": "^7.8.17",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.0.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
